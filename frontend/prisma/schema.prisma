// ============================================================
// LifeFlow — Prisma Schema
// Phase 1 entities: User, Goal, Task, JournalEntry, ActivityLog
// Phase 2 entities: Document, TaskDocument, GoalDocument, Reminder
// Phase 3 entities: Embedding 
// ============================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique
  passwordHash String?  @map("password_hash")
  name         String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  goals          Goal[]
  tasks          Task[]
  journalEntries JournalEntry[]
  documents      Document[]
  activityLogs   ActivityLog[]
  reminders      Reminder[]
  embeddings     Embedding[]

  @@map("users")
}

model Goal {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  title       String
  description String?
  priorityWeight Int        @default(3) @map("priority_weight")
  status         GoalStatus @default(ACTIVE)
  progress    Float    @default(0)
  targetDate  DateTime? @map("target_date") @db.Date
  parentGoalId String? @map("parent_goal_id") @db.Uuid
  parentGoal   Goal?   @relation("GoalHierarchy", fields: [parentGoalId], references: [id])
  subGoals     Goal[]  @relation("GoalHierarchy")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  tasks     Task[]
  documents Document[]

  @@index([userId], name: "idx_goals_user")
  @@map("goals")
}

model Task {
  id          String     @id @default(uuid()) @db.Uuid
  userId      String     @map("user_id") @db.Uuid
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  goalId      String?    @map("goal_id") @db.Uuid
  goal        Goal?      @relation(fields: [goalId], references: [id], onDelete: SetNull)
  title       String
  description String?
  status      TaskStatus @default(TODO)
  priority    Int        @default(3)
  dueDate     DateTime?  @map("due_date")
  recurrenceRule String? @map("recurrence_rule")
  createdAt   DateTime  @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  documents   Document[]
  reminders   Reminder[]

  @@index([userId], name: "idx_tasks_user")
  @@index([goalId], name: "idx_tasks_goal")
  @@map("tasks")
}

model JournalEntry {
  id      String @id @default(uuid()) @db.Uuid
  userId  String @map("user_id") @db.Uuid
  user    User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  content String
  mood   Int?
  energy Int?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([userId], name: "idx_journal_user")
  @@map("journal_entries")
}

model ActivityLog {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id") @db.Uuid
  action     ActionType
  metadata   Json?
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([userId], name: "idx_logs_user")
  @@map("activity_logs")
}

model Document {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  fileName      String   @map("file_name")
  fileType      String   @map("file_type")
  fileSize      Int      @map("file_size")
  storageKey    String   @map("storage_key")
  extractedText String?  @map("extracted_text")
  goalId        String?  @map("goal_id") @db.Uuid
  goal          Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)
  taskId        String?  @map("task_id") @db.Uuid
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId], name: "idx_documents_user")
  @@map("documents")
}

model Reminder {
  id         String         @id @default(uuid()) @db.Uuid
  userId     String         @map("user_id") @db.Uuid
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  taskId     String         @map("task_id") @db.Uuid
  task       Task           @relation(fields: [taskId], references: [id], onDelete: Cascade)
  remindAt   DateTime       @map("remind_at")
  message    String?
  status     ReminderStatus @default(PENDING)
  createdAt  DateTime       @default(now()) @map("created_at")

  @@index([userId], name: "idx_reminders_user")
  @@index([taskId], name: "idx_reminders_task")
  @@index([status, remindAt], name: "idx_reminders_due")
  @@map("reminders")
}

model Embedding {
  id         String     @id @default(uuid()) @db.Uuid
  userId     String     @map("user_id") @db.Uuid
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  entityType EntityType @map("entity_type")
  entityId   String     @map("entity_id") @db.Uuid
  embedding  Unsupported("vector(384)")
  createdAt  DateTime   @default(now()) @map("created_at")

  @@index([entityType, entityId], name: "idx_embeddings_entity")
  @@map("embeddings")
}

enum GoalStatus {
  ACTIVE
  PAUSED
  COMPLETED
  @@map("goal_status")
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
  @@map("task_status")
}

enum EntityType {
  TASK
  GOAL
  JOURNAL
  DOCUMENT
  @@map("entity_type")
}

enum ActionType {
  CREATED
  UPDATED
  COMPLETED
  DELETED
  @@map("action_type")
}

enum ReminderStatus {
  PENDING
  SENT
  DISMISSED
  @@map("reminder_status")
}
