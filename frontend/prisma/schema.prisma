// PHASE 2 ADDITION — Document model
// Add this to your existing schema.prisma, uncommenting the
// Document section and adding the relation to User
// ─────────────────────────────────────────────────────────────

model Document {
  id            String   @id @default(uuid()) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  title         String
  fileName      String   @map("file_name")
  fileType      String   @map("file_type")   // mime type, e.g. "application/pdf"
  fileSize      Int      @map("file_size")   // bytes
  storageKey    String   @map("storage_key") // path in R2 bucket
  extractedText String?  @map("extracted_text") // populated by AI pipeline later

  goalId        String?  @map("goal_id") @db.Uuid
  goal          Goal?    @relation(fields: [goalId], references: [id], onDelete: SetNull)

  taskId        String?  @map("task_id") @db.Uuid
  task          Task?    @relation(fields: [taskId], references: [id], onDelete: SetNull)

  createdAt     DateTime @default(now()) @map("created_at")

  @@index([userId], name: "idx_documents_user")
  @@map("documents")
}

